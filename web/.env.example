ESTOQUE_API_URL="http://localhost:4000"
ESTOQUE_API_KEY="chave-demo"
AUTH_SECRET="troque-esta-chave-em-producao-0123456789"
# Intervalo da rotina automática de verificação de estoque (minutos). 0 desativa.
SYNC_INTERVALO_MIN="5"
# Endereço do sistema usado nos links enviados aos fornecedores
APP_URL="http://localhost:3000"
NOME_HOSPITAL="Hospital Regional"
# Envio real de e-mails (opcional). Sem SMTP_HOST, os e-mails ficam só na tela "E-mails enviados".
# Exemplo com Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", usuário = seu e-mail, senha = "senha de app" do Google
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USUARIO=""
SMTP_SENHA=""
SMTP_REMETENTE=""
# Na apresentação, coloque aqui o seu e-mail: todos os pedidos chegam nele em vez de irem aos fornecedores fictícios
EMAIL_TESTE=""
