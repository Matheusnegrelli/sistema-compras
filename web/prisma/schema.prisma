generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  COMPRADOR
  GESTOR
}

enum StatusNecessidade {
  ABERTA
  EM_COTACAO
  ATENDIDA
  CANCELADA
}

enum StatusCotacao {
  ABERTA
  APROVADA
  CANCELADA
}

enum Criticidade {
  ALTA
  MEDIA
  BAIXA
}

enum Origem {
  AUTOMATICA
  MANUAL
  SIMULADA
  /// Proposta enviada pelo próprio fornecedor pelo link da cotação
  FORNECEDOR
}

enum StatusEmail {
  ENVIADO
  DEMONSTRACAO
  FALHOU
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  senhaHash String
  perfil    Perfil    @default(COMPRADOR)
  ativo     Boolean   @default(true)
  criadoEm  DateTime  @default(now())
  cotacoes  Cotacao[]
  decisoes  Decisao[]
  logs      Log[]
}

/// Setor do hospital (Farmácia, UTI, Centro Cirúrgico...) que consome e controla os itens
model Setor {
  id          Int       @id @default(autoincrement())
  nome        String    @unique
  sigla       String    @unique
  responsavel String?
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  produtos    Produto[]
}

model Produto {
  id                  Int                 @id @default(autoincrement())
  sku                 String              @unique
  nome                String
  unidade             String              @default("UN")
  setorId             Int?
  setor               Setor?              @relation(fields: [setorId], references: [id])
  categoria           String              @default("Material médico-hospitalar")
  /// Itens de criticidade alta (ex.: medicamentos de UTI) aparecem primeiro nos alertas
  criticidade         Criticidade         @default(MEDIA)
  estoqueMinimo       Int                 @default(0)
  estoqueAtual        Int                 @default(0)
  /// Quantidade padrão a comprar quando o item fica abaixo do mínimo (opcional)
  quantidadeReposicao Int?
  precoReferencia     Float?
  ultimaSincronizacao DateTime?
  ativo               Boolean             @default(true)
  criadoEm            DateTime            @default(now())
  atualizadoEm        DateTime            @updatedAt
  necessidades        NecessidadeCompra[]
}

model Fornecedor {
  id            Int                  @id @default(autoincrement())
  nome          String
  cnpj          String               @unique
  email         String?
  telefone      String?
  contato       String?
  /// Nota de histórico (0 a 5), recalculada a cada avaliação de entrega
  notaHistorico Float                @default(3)
  ativo         Boolean              @default(true)
  criadoEm      DateTime             @default(now())
  propostas     Proposta[]
  solicitacoes  SolicitacaoCotacao[]
}

model NecessidadeCompra {
  id               Int               @id @default(autoincrement())
  produtoId        Int
  produto          Produto           @relation(fields: [produtoId], references: [id])
  /// Quantidade a cotar, definida pelo comprador (começa com a sugestão do sistema)
  quantidade       Int
  /// Quantidade sugerida pelo sistema no alerta de estoque
  quantidadeSugerida Int?
  /// Quantidade que o comprador decidiu comprar ao aprovar a proposta
  quantidadeComprada Int?
  estoqueNoMomento Int
  estoqueMinimo    Int
  status           StatusNecessidade @default(ABERTA)
  origem           Origem            @default(AUTOMATICA)
  criadoEm         DateTime          @default(now())
  /// Cotação (por categoria) em que o item está sendo comprado
  cotacaoId        Int?
  cotacao          Cotacao?          @relation(fields: [cotacaoId], references: [id], onDelete: SetNull)
  itensProposta    ItemProposta[]

  @@index([status])
}

model Cotacao {
  id            Int                  @id @default(autoincrement())
  /// Categoria dos produtos reunidos nesta cotação (ex.: Medicamento, EPI)
  categoria     String
  itens         NecessidadeCompra[]
  status        StatusCotacao        @default(ABERTA)
  criadoPorId   Int?
  criadoPor     Usuario?             @relation(fields: [criadoPorId], references: [id])
  criadoEm      DateTime             @default(now())
  /// Data limite para os fornecedores responderem pelo link
  prazoResposta DateTime?
  encerradaEm   DateTime?
  propostas     Proposta[]
  solicitacoes  SolicitacaoCotacao[]
  decisao       Decisao?
}

/// Pedido de cotação enviado a um fornecedor, com o link (token) para ele responder
model SolicitacaoCotacao {
  id            Int            @id @default(autoincrement())
  cotacaoId     Int
  cotacao       Cotacao        @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  fornecedorId  Int
  fornecedor    Fornecedor     @relation(fields: [fornecedorId], references: [id])
  token         String         @unique
  enviadoEm     DateTime       @default(now())
  visualizadoEm DateTime?
  respondidoEm  DateTime?
  /// Fornecedor respondeu que não possui nenhum dos itens da cotação
  semItens      Boolean        @default(false)
  emails        EmailEnviado[]

  @@unique([cotacaoId, fornecedorId])
}

/// Caixa de saída: todo e-mail que o sistema envia (ou simula, sem servidor SMTP)
model EmailEnviado {
  id            Int                 @id @default(autoincrement())
  solicitacaoId Int?
  solicitacao   SolicitacaoCotacao? @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)
  para          String
  assunto       String
  corpo         String
  status        StatusEmail
  erro          String?
  enviadoEm     DateTime            @default(now())

  @@index([enviadoEm])
}

model Proposta {
  id               Int            @id @default(autoincrement())
  cotacaoId        Int
  cotacao          Cotacao        @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  fornecedorId     Int
  fornecedor       Fornecedor     @relation(fields: [fornecedorId], references: [id])
  prazoEntregaDias Int
  observacao       String?
  origem           Origem         @default(MANUAL)
  criadoEm         DateTime       @default(now())
  itens            ItemProposta[]
  decisoes         Decisao[]

  @@unique([cotacaoId, fornecedorId])
}

/// Preço de um fornecedor para um item da cotação
model ItemProposta {
  id                   Int               @id @default(autoincrement())
  propostaId           Int
  proposta             Proposta          @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  necessidadeId        Int
  necessidade          NecessidadeCompra @relation(fields: [necessidadeId], references: [id], onDelete: Cascade)
  precoUnitario        Float
  quantidadeDisponivel Int
  quantidadeMinima     Int               @default(1)

  @@unique([propostaId, necessidadeId])
}

model Decisao {
  id                 Int       @id @default(autoincrement())
  cotacaoId          Int       @unique
  cotacao            Cotacao   @relation(fields: [cotacaoId], references: [id])
  propostaId         Int
  proposta           Proposta  @relation(fields: [propostaId], references: [id])
  /// Usuário que selecionou a proposta (comprador)
  gestorId           Int
  gestor             Usuario   @relation(fields: [gestorId], references: [id])
  /// Pontuação e ranking calculados no momento da decisão (rastreabilidade)
  pontuacao          Float
  ranking            Json
  pesos              Json
  seguiuRecomendacao Boolean
  justificativa      String?
  decididoEm         DateTime  @default(now())
  /// Quando o pedido de compra foi enviado por e-mail ao fornecedor escolhido
  pedidoEnviadoEm    DateTime?
  recebidoEm         DateTime?
  entregueNoPrazo    Boolean?
  avaliacao          Int?
}

model ConfiguracaoPesos {
  id                 Int      @id @default(1)
  preco              Float    @default(40)
  prazo              Float    @default(30)
  disponibilidade    Float    @default(20)
  historico          Float    @default(10)
  /// Gera a cotação e envia aos fornecedores assim que o alerta de estoque é criado
  envioAutomatico    Boolean  @default(true)
  /// Horas que os fornecedores têm para responder
  prazoRespostaHoras Int      @default(48)
  atualizadoEm       DateTime @updatedAt
}

model Sincronizacao {
  id               Int      @id @default(autoincrement())
  origem           Origem
  iniciadoEm       DateTime @default(now())
  duracaoMs        Int
  sucesso          Boolean
  itensLidos       Int      @default(0)
  itensAtualizados Int      @default(0)
  alertasGerados   Int      @default(0)
  erro             String?
}

model Log {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  acao       String
  entidade   String
  entidadeId Int?
  detalhes   String?
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
}
